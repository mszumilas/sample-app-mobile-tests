{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["@wdio/globals", "node", "mocha"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "@pages/*": ["./pageobjects/*"],
      "@helpers/*": ["./helpers/*"],
      "@hooks/*": ["./hooks/*"]
    },
    "outDir": "./dist"
  },
  "include": [
    "./test/**/*.ts",
    "./pageobjects/**/*.ts",
    "./wdio.conf.ts",
    "./helpers/**/*.ts",
    "./hooks/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
